import TEM from "./TEM.id.json";
import { T6D } from "./TEM6D.js";

export function TEM6D_ROOT(station){
    if(!TEM.override) return station;

    // Zeitachsen stabilisieren
    T6D.t = [100, 100, 100];

    return {
        ...station,
        score: 100,
        color: "green",
        speed: 1.0,
        timeVector: [...T6D.t],
        projectedTime: T6D.project(),
        desc: "TEM-6D Root Override"
    };
}
1
